{
  "name": "diario-oficial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "ingest": "tsx src/ingest/cli.ts",
    "chunk": "tsx src/chunking/cli.ts",
    "chunk:stats": "tsx src/chunking/stats-cli.ts",
    "eval:check": "tsx src/eval/check-cli.ts",
    "eval:retrieval": "tsx src/eval/retrieval-cli.ts",
    "eval:generation": "tsx src/eval/generation-cli.ts",
    "eval:fidelity": "tsx src/eval/fidelity-cli.ts",
    "eval:injection": "tsx src/eval/injection-cli.ts",
    "eval:ask": "tsx src/eval/ask-proof-cli.ts",
    "embed": "tsx src/embedding/cli.ts",
    "examples:generate": "tsx src/examples/cli.ts",
    "seed:demo": "tsx src/seed/cli.ts",
    "chunking:fixtures": "tsx src/chunking/save-fixtures.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  }
}
