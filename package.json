{
  "name": "diario-oficial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "ingest": "tsx src/ingest/cli.ts",
    "chunk": "tsx src/chunking/cli.ts",
    "chunk:stats": "tsx src/chunking/stats-cli.ts",
    "eval:check": "tsx src/eval/check-cli.ts",
    "eval:retrieval": "tsx src/eval/retrieval-cli.ts",
    "embed": "tsx src/embedding/cli.ts",
    "chunking:fixtures": "tsx src/chunking/save-fixtures.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.5",
    "groq-sdk": "^1.6.0",
    "next": "16.3.8",
    "pino": "^10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.15.1"
}
