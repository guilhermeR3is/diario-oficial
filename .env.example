# Copie para .env e preencha. O .env não vai para o git.

# Banco local (lidos pelo docker-compose.yml)
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=SENHA
POSTGRES_DB=diario_oficial
POSTGRES_PORT=5433

# Precisa repetir usuário, senha, porta e banco acima
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/diario_oficial

LIVE_MODE=off
LOG_LEVEL=info
