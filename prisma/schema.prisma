generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EditionStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("edition_status")
}

model Territory {
  id       Int       @id @default(autoincrement())
  ibgeCode String    @unique @map("ibge_code")
  name     String
  uf       String
  editions Edition[]

  @@map("territory")
}

model Edition {
  id            Int           @id @default(autoincrement())
  territoryId   Int           @map("territory_id")
  territory     Territory     @relation(fields: [territoryId], references: [id])
  title         String
  date          DateTime      @db.Date
  sourceUrl     String        @unique @map("source_url")
  contentHash   String?       @map("content_hash")
  pageCount     Int?          @map("page_count")
  status        EditionStatus @default(PENDING)
  failureReason String?       @map("failure_reason")
  // null enquanto a edição não foi cortada em trechos; [] quando o corte não achou problema
  chunkProblems Json?         @map("chunk_problems")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  chunks        Chunk[]

  @@index([territoryId, date])
  @@map("edition")
}

model Chunk {
  id          Int      @id @default(autoincrement())
  editionId   Int      @map("edition_id")
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  ordinal     Int
  actType     String   @map("act_type")
  title       String
  secretariat String?
  date        DateTime @db.Date
  page        Int
  pageEnd     Int      @map("page_end")
  text        String
  tokenCount  Int      @map("token_count")
  contentHash String   @map("content_hash")

  @@unique([editionId, ordinal])
  @@map("chunk")
}
