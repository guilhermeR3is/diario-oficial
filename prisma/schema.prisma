generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EditionStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("edition_status")
}

model Territory {
  id       Int       @id @default(autoincrement())
  ibgeCode String    @unique @map("ibge_code")
  name     String
  uf       String
  editions Edition[]

  @@map("territory")
}

model Edition {
  id            Int           @id @default(autoincrement())
  territoryId   Int           @map("territory_id")
  territory     Territory     @relation(fields: [territoryId], references: [id])
  title         String
  date          DateTime      @db.Date
  sourceUrl     String        @unique @map("source_url")
  contentHash   String?       @map("content_hash")
  pageCount     Int?          @map("page_count")
  status        EditionStatus @default(PENDING)
  failureReason String?       @map("failure_reason")
  // null enquanto a edição não foi cortada em trechos; [] quando o corte não achou problema
  chunkProblems Json?         @map("chunk_problems")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  chunks        Chunk[]

  @@index([territoryId, date])
  @@map("edition")
}

model Chunk {
  id             Int                         @id @default(autoincrement())
  editionId      Int                         @map("edition_id")
  edition        Edition                     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  ordinal        Int
  actType        String                      @map("act_type")
  title          String
  secretariat    String?
  date           DateTime                    @db.Date
  page           Int
  pageEnd        Int                         @map("page_end")
  text           String
  tokenCount     Int                         @map("token_count")
  contentHash    String                      @map("content_hash")
  // o Prisma não tem tipo para vetor: a coluna só é lida e escrita por SQL puro
  embedding      Unsupported("vector(768)")?
  embeddingModel String?                     @map("embedding_model")
  // preenchida pelo trigger chunk_fill_tsv; o Prisma só precisa conhecer a coluna e o índice
  tsv            Unsupported("tsvector")?

  @@unique([editionId, ordinal])
  @@index([tsv], type: Gin)
  @@map("chunk")
}

// respostas das perguntas de exemplo, geradas uma vez e servidas sem chamar o modelo
model CachedAnswer {
  id            Int      @id @default(autoincrement())
  questionSlug  String   @unique @map("question_slug")
  question      String
  answer        String
  // lista ordenada de { sourceUrl, ordinal }: o [n] da resposta aponta para o item n; o id do trecho muda se o banco for recriado
  citations     Json
  model         String
  promptVersion String   @map("prompt_version")
  position      Int      @unique
  generatedAt   DateTime @map("generated_at")

  @@map("cached_answer")
}

// uma linha por pergunta livre respondida; o id é aleatório para que ninguém dê feedback na resposta dos outros adivinhando números
model QueryLog {
  id                String   @id @default(uuid()) @db.Uuid
  question          String
  searchMode        String   @map("search_mode")
  retrievedChunkIds Int[]    @map("retrieved_chunk_ids")
  answer            String
  model             String
  promptVersion     String   @map("prompt_version")
  latencyMs         Int      @map("latency_ms")
  // null nas linhas de antes da Fase 8 e quando o provedor não informa o consumo
  totalTokens       Int?     @map("total_tokens")
  // hash do IP com a data e um segredo: o IP nunca é gravado e o mesmo visitante não se liga de um dia para o outro
  visitorHash       String?  @map("visitor_hash")
  feedback          String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("query_log")
}

// uma linha por dia e chave ("site" ou o hash de um visitante); somar e conferir o limite é uma instrução só, então pedidos simultâneos não passam do limite
model LiveUsage {
  day   DateTime @db.Date
  key   String
  count Int

  @@id([day, key])
  @@map("live_usage")
}
